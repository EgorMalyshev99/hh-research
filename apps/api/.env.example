# =============================================================================
# job-research API — переменные окружения (скопировать в .env)
# =============================================================================

# --- PostgreSQL (prod) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/job_research?sslmode=require

# --- JWT (обязательно ≥ 32 символов для секретов) ---
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- HTTP ---
PORT=3000
NODE_ENV=development

DASHBOARD_URL=http://dashboard.job-research.loc:3001
LANDING_URL=http://landing.job-research.loc:3002

# --- Vacancy import ---
TRUDVSEM_API_BASE=https://opendata.trudvsem.ru/api/v1
SUPERJOB_API_BASE=https://api.superjob.ru/2.0
# SUPERJOB_APP_ID=
VACANCY_IMPORT_MAX_LIMIT=200

# --- LLM ---
LLM_REQUEST_TIMEOUT_MS=120000
GEMINI_API_KEY=

# --- Telegram (опционально) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ERRORS_CHAT_ID=
TELEGRAM_VACANCY_DIGEST_LIMIT=20
